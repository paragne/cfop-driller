  "narrative": {
    "northStar": "The Flash Card",
    "overview": "One card, one answer, next. The screen is a flash card held up in a dark room: the case picture is the card face, and everything else is the hand holding it. The tool is used with a cube in one hand and a thumb or a keyboard in the other, in short daily sessions, so every element earns its place by speeding up the next card.\n\nDense, fast, high-contrast. A drilling tool, not a marketing page. Near-black ground, bright cube, grayscale chrome, and one violet that means \"do this\". Flat surfaces separated by 1px hairlines. No ornament.\n\nMobile first, single column. Desktop gets more padding and a three-button action row, not a different layout.",
    "keyCharacteristics": [
      "The case picture is the largest element on screen by a wide margin.",
      "Grayscale chrome, one accent for the primary action.",
      "System fonts only, monospace for algs.",
      "Flat, hairline borders, 2px corners.",
      "Primary actions in the thumb zone at the bottom."
    ],
    "rules": [
      {
        "name": "The One Signal Rule",
        "body": "Lavender Signal appears on the primary action and nowhere else. A pressed toggle inverts to Bone White on Ink Black, never violet, so the accent always means \"the next step\".",
        "section": "colors"
      },
      {
        "name": "The Rainbow Stays Home Rule",
        "body": "Set colors live in the home stats only. They never tint cards, buttons or the cube.",
        "section": "colors"
      },
      {
        "name": "The Label Beside Hue Rule",
        "body": "Hue is never the only carrier of meaning. Every set color sits next to its set name, and learned versus missed ticks differ in opacity as well as presence.",
        "section": "colors"
      },
      {
        "name": "The Executable Is Mono Rule",
        "body": "If the user can turn it on a cube or press it on a keyboard, it is set in monospace. Nothing else is.",
        "section": "typography"
      },
      {
        "name": "The No Font Loading Rule",
        "body": "No web fonts. The app must render its first card offline with nothing to fetch.",
        "section": "typography"
      },
      {
        "name": "The Picture Wins Rule",
        "body": "The case picture is the largest element on screen by a wide margin. If a new element shrinks it noticeably on a phone, the element moves or goes.",
        "section": "layout"
      },
      {
        "name": "The Thumb Zone Rule",
        "body": "Primary actions sit in the lower third, reachable by thumb on a phone.",
        "section": "layout"
      },
      {
        "name": "The Hairline Not Shadow Rule",
        "body": "Separation is a 1px Hairline border or a background step, never a shadow.",
        "section": "elevation"
      },
      {
        "name": "The Nothing Moves Rule",
        "body": "Opening a popover, menu or drawer never reflows the page. It overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep Lavender Signal on the one primary action per screen.",
      "**Do** invert to Bone White on Ink Black for any pressed or selected state.",
      "**Do** use a 1px Hairline and Panel Graphite for every new surface.",
      "**Do** set algs, notation and key hints in the mono stack.",
      "**Do** design at phone width first, single column, then add padding on desktop.",
      "**Do** pair every set color with its set name."
    ],
    "donts": [
      "**Don't** add web fonts or any font loading.",
      "**Don't** use shadows, gradients, glass effects or blur.",
      "**Don't** use corners rounder than 2px on controls or panels.",
      "**Don't** open modal dialogs. Notes edit in place; menus and drawers overlay without blocking.",
      "**Don't** animate transitions unless the motion conveys a state change (3D move playback is that state change).",
      "**Don't** use set colors outside the home stats.",
      "**Don't** design a desktop layout and shrink it."
    ]
  }
}
